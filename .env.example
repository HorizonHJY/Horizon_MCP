# Copy to .env on the server and fill in. .env is gitignored.

# The site's SQLite database. Opened read-only; the tools never write to it.
HORIZON_DB_PATH=/home/ec2-user/Horisation/_data/market.db

# Where export files are written. Must be writable by the user OpenClaw runs as,
# and should be OUTSIDE any git checkout.
HORIZON_EXPORT_DIR=/home/ec2-user/horizon-exports

# Hard cap on rows per export, so a mistaken request cannot dump the whole
# message history to a phone. Raise deliberately if you need to.
HORIZON_EXPORT_MAX_ROWS=5000
