# Copy to .env and fill in. .env is gitignored.
#
# Pick ONE of the two blocks.

# ── A. On the Mac mini (OpenClaw here, data on the EC2 box) ─────────────────
# The server and the database path on it. `archbay` is an alias you define in
# ~/.ssh/config (see INSTALL.md); no key path or password goes here.
HORIZON_DB_SSH=archbay:/home/ec2-user/Horisation/_data/market.db
# Where the pulled snapshot lives locally, and how long one is reused (seconds)
# before the next tool call fetches a fresh one.
HORIZON_DB_PATH=~/horizon-exports/market.snapshot.db
HORIZON_SNAPSHOT_MAX_AGE=300

# ── B. On the EC2 box itself (data is a local file) ─────────────────────────
# Leave HORIZON_DB_SSH unset and point straight at the database.
#HORIZON_DB_PATH=/home/ec2-user/Horisation/_data/market.db

# ── Both ────────────────────────────────────────────────────────────────────
# Where export files are written. Must be writable by the user OpenClaw runs
# as, and OUTSIDE any git checkout.
HORIZON_EXPORT_DIR=~/horizon-exports

# Hard cap on rows per export, so a mistaken request cannot dump the whole
# message history to a phone. Raise deliberately if you need to.
HORIZON_EXPORT_MAX_ROWS=5000
